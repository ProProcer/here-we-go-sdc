# Copy this file to .env (local) or add these to Replit Secrets.
# Never commit your real .env file.
# The web app does not require API keys. Startup reads process environment;
# The web app loads known settings from local .env without overriding the host.
# Replit sets PORT in .replit.
PORT=8000

# Shared policy for all AI tasks: Groq GPT-OSS-120B primary, RunPod GLM then Gemini backups.
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=runpod,gemini
GROQ_API=
GROQ_MODEL=openai/gpt-oss-120b
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_MODEL=zai-org/GLM-4.7-Flash

# Optional automatic CV skill-level estimates and Role 3 candidate extraction.
# Web estimates use one request for up to 12 extracted skills per upload.
# If missing/unavailable, intake still works and levels stay unknown.
# Keep actual keys in your environment/Replit Secrets, never in tracked files.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Native Gemini CLI compatibility only; the shared router makes one backup request.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.8-flash
