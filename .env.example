# Copy this file to .env (local) or add these to Replit Secrets.
# Never commit your real .env file.
PROJECT_NAME="Project Name"
RUNPOD_API_KEY=your-runpod-api-key
RUNPOD_ENDPOINT_ID=your-endpoint-id

# Optional Role 3 candidate extraction (CLI reads process environment).
# Keep actual keys in your environment/Replit Secrets, never in tracked files.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Comma-separated, in order; use "none" to disable fallback.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.8-flash
